{
  "name": "openrouter-clone",
  "private": true,
  "description": "Orbyt: self-hosted LLM API gateway with an OpenAI-compatible endpoint, model fallback, retries, cost-based routing, BYOK and request tracing. TypeScript, Node.js, Express, Next.js, React, PostgreSQL, Prisma, Turborepo.",
  "keywords": [
    "llm-gateway",
    "ai-gateway",
    "api-gateway",
    "openai-api",
    "gemini-api",
    "typescript",
    "nodejs",
    "expressjs",
    "nextjs",
    "react",
    "tailwindcss",
    "postgresql",
    "prisma",
    "turborepo",
    "monorepo",
    "rest-api",
    "clerk-auth",
    "backend",
    "fullstack",
    "developer-tools"
  ],
  "homepage": "https://openrouter-clone-dashboard.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ManasSaxena14/Orbyt_Openrouter-clone.git"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "tsx": "^4.21.0",
    "turbo": "^2.8.11",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
